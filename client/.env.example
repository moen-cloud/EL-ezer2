# Copy this file to .env and fill in your own values.
# .env is already ignored by git, so your real keys never get committed.

# --- Cloudinary ---
# Your Cloudinary "cloud name" (found on your Cloudinary dashboard).
# Every image on the site is built from this value, so nothing will show
# up correctly until it's set.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- Formspree ---
# Create a free account at https://formspree.io, create one form per
# purpose below, and paste in just the form ID (the part after /f/ in
# your form's endpoint, e.g. "mzblvqkd").
# VITE_FORMSPREE_CONTACT_ID= mjybkrjq
# VITE_FORMSPREE_NEWSLETTER_ID= xoeavwrw
# VITE_FORMSPREE_AUDIT_ID= mwlepbyr
